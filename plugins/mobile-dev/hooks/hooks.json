{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-log-commands.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for log-streaming commands"
          }
        ]
      }
    ]
  }
}
